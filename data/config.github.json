    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 5,
          "min_score": 80,
          "category": "ai-research",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 6,
          "min_score": 40,
          "category": "open-source-ai",
          "profile": "tech-news"
        },
        {
          "subreddit": "AI_Agents",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 6,
          "min_score": 15,
          "category": "ai-agents",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "agent",
        "llm",
        "rag",
        "mcp",
        "model",
        "copilot",
        "multimodal",
        "robotics",
        "inference",
        "ai-safety"
      ],
      "min_stars": 20,
      "max_items": 12,
      "category": "oss-trending",
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "profile": "tech-news"
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "gdelt": {
      "enabled": false,
      "query": "artificial intelligence",
      "mode": "ArtList",
      "max_records": 50,
      "category": "news",
      "profile": "tech-news"
    },
    "google_news": {
      "enabled": false,
      "query": "中国经济 OR 美联储 OR 利率 OR 通胀 OR 全球股市 OR AI科技股",
      "language": "zh-CN",
      "country": "CN",
      "ceid": null,
      "max_results": 40,
      "category": "macro-finance",
      "profile": "finance-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "finance-news"
    ],
    "category_groups": {
      "official": {
        "name": "新模型与 AI 产品",
        "limit": 3,
        "categories": [
          "official-ai",
          "ai-product"
        ]
      },
      "agents": {
        "name": "Agent / RAG / MCP / AI 编程",
        "limit": 2,
        "categories": [
          "agent-platform",
          "agent-framework",
          "ai-agents",
          "rag",
          "mcp",
          "ai-coding"
        ]
      },
      "opensource": {
        "name": "AI 工具与开源项目",
        "limit": 2,
        "categories": [
          "open-source-ai",
          "oss-trending"
        ]
      },
      "research": {
        "name": "AI 研究、基础设施与安全",
        "limit": 2,
        "categories": [
          "ai-research",
          "tech-news"
        ]
      },
      "industry": {
        "name": "AI 商业、融资、政策与行业",
        "limit": 3,
        "categories": [
          "ai-industry",
          "news"
        ]
      },
      "a_share": {
        "name": "A股",
        "limit": 2,
        "categories": [
          "a-share"
        ]
      },
      "hk_stocks": {
        "name": "港股",
        "limit": 2,
        "categories": [
          "hk-stocks"
        ]
      },
      "us_stocks": {
        "name": "美股",
        "limit": 2,
        "categories": [
          "us-stocks"
        ]
      },
      "crypto": {
        "name": "加密货币",
        "limit": 2,
        "categories": [
          "crypto"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
