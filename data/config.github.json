{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 4,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 7.2,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "langgenius",
        "repo": "dify",
        "enabled": true,
        "category": "agent-platform",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "infiniflow",
        "repo": "ragflow",
        "enabled": true,
        "category": "rag",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langgraph",
        "enabled": true,
        "category": "agent-framework",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "autogen",
        "enabled": true,
        "category": "agent-framework",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "agent-framework",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "ai-coding",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "servers",
        "enabled": true,
        "category": "mcp",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 40,
      "min_score": 80,
      "category": "tech-news",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-ai",
        "profile": "tech-news"
      },
      {
        "name": "Google AI",
        "url": "https://blog.google/technology/ai/rss/",
        "enabled": true,
        "category": "official-ai",
        "profile": "tech-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "open-source-ai",
        "profile": "tech-news"
      },
      {
        "name": "GitHub Changelog",
        "url": "https://github.blog/changelog/feed/",
        "enabled": true,
        "category": "ai-product",
        "profile": "tech-news"
      },
      {
        "name": "Product Hunt",
        "url": "https://www.producthunt.com/feed",
        "enabled": true,
        "category": "ai-product",
        "profile": "tech-news"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-agents",
        "profile": "tech-news"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-industry",
        "profile": "tech-news"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news"
      },
      {
        "name": "Financial Times Markets",
        "url": "https://www.ft.com/markets?format=rss",
        "enabled": true,
        "category": "markets",
        "profile": "finance-news"
      },
      {
        "name": "Yahoo Finance",
        "url": "https://finance.yahoo.com/news/rssindex",
        "enabled": true,
        "category": "markets",
        "profile": "finance-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 30,
          "category": "ai-research",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 30,
          "category": "open-source-ai",
          "profile": "tech-news"
        },
        {
          "subreddit": "AI_Agents",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 10,
          "category": "ai-agents",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "agent",
        "llm",
        "rag",
        "mcp",
        "model",
        "copilot"
      ],
      "min_stars": 20,
      "max_items": 20,
      "category": "oss-trending",
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "profile": "tech-news"
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "gdelt": {
      "enabled": false,
      "query": "artificial intelligence",
      "mode": "ArtList",
      "max_records": 50,
      "category": "news",
      "profile": "tech-news"
    },
    "google_news": {
      "enabled": true,
      "query": "中国经济 OR 美联储 OR 利率 OR 通胀 OR 全球股市 OR AI科技股",
      "language": "zh-CN",
      "country": "CN",
      "ceid": null,
      "max_results": 40,
      "category": "macro-finance",
      "profile": "finance-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 16,
    "profile_order": [
      "tech-news",
      "finance-news"
    ],
    "category_groups": {
      "official": {
        "name": "官方模型与产品",
        "limit": 6,
        "categories": [
          "official-ai",
          "ai-product"
        ]
      },
      "agents": {
        "name": "Agent / RAG / MCP",
        "limit": 6,
        "categories": [
          "agent-platform",
          "agent-framework",
          "ai-agents",
          "rag",
          "mcp",
          "ai-coding"
        ]
      },
      "opensource": {
        "name": "开源与趋势",
        "limit": 6,
        "categories": [
          "open-source-ai",
          "oss-trending"
        ]
      },
      "research": {
        "name": "研究与行业",
        "limit": 4,
        "categories": [
          "ai-research",
          "ai-industry"
        ]
      },
      "finance": {
        "name": "金融与宏观",
        "limit": 4,
        "categories": [
          "finance",
          "markets",
          "macro-finance",
          "equities"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}
